{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angel-answers-oracle",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "angel.orlumi.app", "custom_domain": true }
  ],
  "secrets": {
    "required": ["ORACLE_PASSWORD_HASH", "ORACLE_SESSION_KEY"]
  }
}
